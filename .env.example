# ==============================================================================
# ResQAI — AI-Powered Emergency Management & Response System
# Environment Configuration Template (.env.example)
# Copy this file to .env to configure local or deployment parameters.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=5000

# Security & Role-Based Authentication
# Secret key used for signing HS256 JSON Web Tokens (JWT)
RESQAI_JWT_SECRET=replace-with-a-secure-random-secret-key-for-production

# External Real-Data Integrations (No-Mandatory-Key Strategy)
# 1. Open-Meteo Weather & Geocoding: 100% Free, No key needed
# 2. USGS Earthquakes GeoJSON: 100% Free, No key needed
# 3. NDMA SACHET India CAP/RSS: 100% Free Public Feed, No key needed
# 4. OSRM Driving Router: Free demo server with geodesic fallback

# Optional: NASA FIRMS (Fire Information for Resource Management System)
# Request a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left blank, the system operates in transparent Standby mode with no false alerts.
NASA_FIRMS_MAP_KEY=

# Optional: Local Ollama LLM endpoint (default: http://localhost:11434)
# If offline or not installed, deterministic multilingual rule engine executes seamlessly.
OLLAMA_ENDPOINT=http://localhost:11434

# Optional: Notification Provider Credentials (for real SMS / Email dispatch)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
